{
  "multipart": [
    {"when": {"axis": "x", "axis_direction": "false"}, "apply": {"model": "extendedgears:block/large_half_shaft_cogwheel", "x": 90, "y": 270}},
    {"when": {"axis": "y", "axis_direction": "false"}, "apply": {"model": "extendedgears:block/large_half_shaft_cogwheel", "x": 180}},
    {"when": {"axis": "z", "axis_direction": "false"}, "apply": {"model": "extendedgears:block/large_half_shaft_cogwheel", "x": 90}},
    {"when": {"axis": "x", "axis_direction": "true"}, "apply": {"model": "extendedgears:block/large_half_shaft_cogwheel", "x": 90, "y": 90}},
    {"when": {"axis": "y", "axis_direction": "true"}, "apply": {"model": "extendedgears:block/large_half_shaft_cogwheel"}},
    {"when": {"axis": "z", "axis_direction": "true"}, "apply": {"model": "extendedgears:block/large_half_shaft_cogwheel", "x": 90, "y": 180}}
  ]
}
